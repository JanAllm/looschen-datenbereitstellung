# Kopiere diese Datei zu ".env" (ohne .example) und passe den Pfad an.
# PROJECT_FOLDER = Host-Ordner mit den G-Code-Projekten, wird im Container
# nach /data/projects (nur lesend) eingehängt.
#
# Windows-Beispiel (Vorwärts-Slashes verwenden):
#   PROJECT_FOLDER=D:/CNC/Projekte
# Linux-Beispiel:
#   PROJECT_FOLDER=/srv/cnc/projekte
#
# Ohne gesetzten Wert wird ./BeispielDatensatz erwartet (auf einem fremden
# Rechner nicht vorhanden!) -> daher hier immer einen echten Ordner eintragen.

PROJECT_FOLDER=D:/CNC/Projekte
